# Configurações para Docker
NODE_ENV=production
PORT=3002

# n8n Webhook URL (ajustar conforme necessário)
N8N_WEBHOOK_URL=https://n8n.versa.tec.br/webhook/versa_urb_chat

# Chave de administrador (gerar uma nova para produção)
ADMIN_KEY=your-secure-admin-key-here

# Configurações de CORS
CORS_ORIGIN=*

# Configurações de mensagem
MESSAGE_RETENTION_HOURS=24
MAX_MESSAGE_LENGTH=1000

# Configurações de log
LOG_LEVEL=info

# Configurações de saúde
HEALTH_CHECK_INTERVAL=30000

# Configurações de rate limiting (se implementado)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Timezone
TZ=America/Sao_Paulo

# Configurações de memória (para containers)
NODE_OPTIONS=--max-old-space-size=512